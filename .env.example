# 실제 값은 로컬 .env 또는 실행 셸 환경변수에만 기입. Git 포함 금지.
# 앱은 .env 파일을 자동으로 읽지 않는다(README.md 실행 안내 참고).
OPENAI_API_KEY=
# 텍스트 구조화 결과 모델(초기 후보, 접근 권한·품질·비용 미검증)
OPENAI_MODEL=gpt-5.4-mini
# 이미지 생성 모델(초기 후보, 접근 권한·품질·비용 미검증). 비워 두어도 텍스트 기능과 화면은 동작
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# 시장 분석 근거 자료 수집(2026-10-25 추가 제안, 공통 검토 필요). 비워 두면 해당 출처는 '설정 필요'로 표시되고 나머지는 동작
# 공공데이터포털 서비스키(KOTRA 해외시장뉴스 15034831 활용 신청 후 마이페이지에서 확인). 디코딩 키 권장, 인코딩 키도 동작
DATA_GO_KR_SERVICE_KEY=
