# 실제 값은 로컬 .env 또는 실행 셸 환경변수에만 기입. Git 포함 금지.
# 프로젝트 루트에서 python app.py로 실행하면 Flask가 python-dotenv로 .env를 자동으로 읽는다.
# 이미 OS·셸에 설정된 환경변수가 우선이며 .env가 덮어쓰지 않는다. .env가 없어도 앱은 실행된다(README.md ".env 로딩" 참고).
# 이 파일에는 변수명과 빈 값(또는 공개 가능한 기본 후보)만 둔다.
OPENAI_API_KEY=
# 텍스트 구조화 결과 모델(초기 후보, 접근 권한·품질·비용 미검증)
OPENAI_MODEL=gpt-5.4-mini
# 이미지 생성 모델(초기 후보, 접근 권한·품질·비용 미검증). 비워 두어도 텍스트 기능과 화면은 동작
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# KOTRA 해외시장뉴스 Open API 인증키(공공데이터포털). 비워 두면 홈 업계 소식의 KOTRA만 "설정 필요"로 표시
KOTRA_API_KEY=
# 한국수출입은행 현재환율 Open API 인증키(한국수출입은행 홈페이지에서 발급). 비워 두면 홈 환율의 USD/KRW만 "설정 필요"로 표시
KOREAEXIM_API_KEY=
